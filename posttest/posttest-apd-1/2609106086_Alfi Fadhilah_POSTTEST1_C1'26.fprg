<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Alfi Fadhilah"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-15 08:13:33 PM"/>
        <attribute name="created" value="QWxmaSBGYWRoaWxhaDtMQVBUT1AtRUhGUzVRVkI7MjAyNi0wOS0xNTsxMToxOToyMyBBTTszNTU3"/>
        <attribute name="edited" value="QWxmaSBGYWRoaWxhaDtMQVBUT1AtRUhGUzVRVkI7MjAyNi0wOS0xNTswODoxMzozMyBQTTsyOzM2ODI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="jumlahTiket, i, usia, hargaDasar, hargaSatuan, totalHarga" type="Integer" array="False" size=""/>
            <assign variable="hargaDasar" expression="60000"/>
            <assign variable="totalHarga" expression="0"/>
            <output expression="&quot;Selamat Datang di Cinemax&quot;" newline="True"/>
            <output expression="&quot;Masukkan jumlah tiket yang ingin dibeli: &quot;" newline="True"/>
            <input variable="jumlahTiket"/>
            <for variable="i" start="1" end="jumlahTiket" direction="inc" step="1">
                <output expression="&quot;Masukkan usia penonton ke-&quot; &amp; i &amp; &quot;: &quot;" newline="True"/>
                <input variable="usia"/>
                <if expression="usia &lt; 12">
                    <then>
                        <assign variable="hargaSatuan" expression="hargaDasar - (hargaDasar * 0.2)"/>
                    </then>
                    <else>
                        <if expression="usia &lt;= 60">
                            <then>
                                <assign variable="hargaSatuan" expression="hargaDasar"/>
                            </then>
                            <else>
                                <assign variable="hargaSatuan" expression="hargaDasar - (hargaDasar * 0.3)"/>
                            </else>
                        </if>
                    </else>
                </if>
                <assign variable="totalHarga" expression="totalHarga + hargaSatuan"/>
            </for>
            <output expression="&quot;Total yang harus dibayar: Rp &quot; &amp; totalHarga" newline="True"/>
        </body>
    </function>
</flowgorithm>
